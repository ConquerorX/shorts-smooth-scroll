{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "version": "1.1.2",
  "description": "__MSG_extDescription__",
  "default_locale": "en",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage"],
  "host_permissions": ["*://*.youtube.com/*"],
  "action": {
    "default_title": "__MSG_actionTitle__",
    "default_popup": "src/popup.html"
  },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["src/core.js", "src/content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
